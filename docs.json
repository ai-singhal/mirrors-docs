{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mirrors",
  "description": "Build a runnable twin of the backends your AI agent talks to, replay real sessions against every change, and catch regressions before production.",
  "colors": {
    "primary": "#0E3BB9",
    "light": "#839EF5",
    "dark": "#112A7C"
  },
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "https://www.runmirrors.com"
  },
  "favicon": "/favicon.png",
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://www.runmirrors.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://www.runmirrors.com/request-access"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.runmirrors.com",
      "x": "https://x.com/runmirrors",
      "linkedin": "https://www.linkedin.com/company/runmirrors"
    }
  },
  "redirects": [
    {
      "source": "/README",
      "destination": "/"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "how-it-works",
              "traces"
            ]
          },
          {
            "group": "Ways in",
            "pages": [
              "collectors",
              "mcp",
              "cli"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "api-keys",
              "plans-and-usage"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "for-agents"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "reference/introduction",
              "reference/collect",
              "reference/envs",
              "reference/tools",
              "reference/build"
            ]
          },
          {
            "group": "Generated reference",
            "pages": [
              "reference/formats",
              "reference/getting-started",
              "reference/inputs",
              "reference/overrides",
              "reference/verbs"
            ]
          }
        ]
      }
    ]
  }
}
