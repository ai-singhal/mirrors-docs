{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mirrors",
  "description": "Mirrors helps developers maintain production AI agents by turning recurring mistakes into targeted corrections. Current documentation: https://mirrors.dev/docs",
  "colors": {
    "primary": "#0E3BB9",
    "light": "#839EF5",
    "dark": "#112A7C"
  },
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "https://mirrors.dev"
  },
  "favicon": "/favicon.png",
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Current docs",
        "href": "https://mirrors.dev/docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to mirrors.dev",
      "href": "https://mirrors.dev"
    }
  },
  "footer": {
    "socials": {
      "website": "https://mirrors.dev",
      "x": "https://x.com/mirrorsdotdev",
      "linkedin": "https://www.linkedin.com/company/runmirrors"
    }
  },
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "redirects": [
    {
      "source": "/README",
      "destination": "/"
    },
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/how-it-works",
      "destination": "/"
    },
    {
      "source": "/traces",
      "destination": "/"
    },
    {
      "source": "/collectors",
      "destination": "/"
    },
    {
      "source": "/cli",
      "destination": "/"
    },
    {
      "source": "/api-keys",
      "destination": "/"
    },
    {
      "source": "/plans-and-usage",
      "destination": "/"
    },
    {
      "source": "/for-agents",
      "destination": "/"
    },
    {
      "source": "/reference/:slug*",
      "destination": "/"
    }
  ],
  "navigation": {
    "pages": [
      "index"
    ]
  }
}
